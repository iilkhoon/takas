# Server
PORT=4000
NODE_ENV=development
# Saytın ictimai ünvanı (cookie, ödəniş callback-ləri üçün)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deyis?schema=public

# Mütləq dəyişdirin! (openssl rand -hex 32)
JWT_SECRET=change-me-access-secret
REFRESH_SECRET=change-me-refresh-secret

UPLOAD_DIR=./uploads

# Ödəniş: mock (test) və ya epoint
PAYMENT_PROVIDER=mock
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=

# Admin hesabı (seed zamanı yaradılır)
ADMIN_EMAIL=admin@deyis.az
ADMIN_PASSWORD=Admin12345!
